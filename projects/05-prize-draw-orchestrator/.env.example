# LLM backend: "ollama" (default, local, no data leaves this machine),
# "deepseek", or "claude". DeepSeek/Claude are opt-in only - see README for
# the informed-consent requirements before enabling either.
LLM_PROVIDER=ollama

# --- Ollama (default backend) ---
OLLAMA_HOST=http://localhost:11434
OLLAMA_MODEL=llama3

# --- DeepSeek (opt-in; sends prompt content to api.deepseek.com) ---
# DEEPSEEK_API_KEY=
# DEEPSEEK_MODEL=deepseek-v4-flash

# --- Claude (opt-in; sends prompt content to api.anthropic.com) ---
# ANTHROPIC_API_KEY=
# CLAUDE_MODEL=claude-sonnet-4-6

# --- MCP server (issue #22) connection ---
# Command used to launch the prize-draw MCP server over stdio, e.g. the
# path to its Python interpreter, and MCP_SERVER_ARGS as either a
# space-separated list or a JSON array, e.g. '["server.py"]'.
MCP_SERVER_COMMAND=python
MCP_SERVER_ARGS=["../path/to/prize-draw-mcp-server/server.py"]

# --- Safety gates ---
# Dry-run is on by default: eligible draws are logged, never actually
# submitted, until this is explicitly turned off (or --live is passed).
DRY_RUN=true
# Must be explicitly set to true (after human review) before draws whose
# entry form plausibly asks for personal/financial data are auto-submitted.
CONFIRM_PERSONAL_DATA=false

# --- Criteria and scheduling ---
# Path to a JSON file describing which draws to match (prize type/value,
# entry method, region/eligibility, closing date); see criteria.example.json.
CRITERIA_CONFIG_PATH=criteria.example.json
RUN_INTERVAL_MINUTES=60
