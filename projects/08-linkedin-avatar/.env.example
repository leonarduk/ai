# Required
DEEPSEEK_API_KEY=

# Provider selection (see docs/design.md §7)
AVATAR_PROVIDER=deepseek
AVATAR_MODEL=deepseek-v4-flash

# Only needed if AVATAR_PROVIDER=anthropic (documented fallback, not the default path)
ANTHROPIC_API_KEY=

# Guardrails (see docs/design.md §6, §10)
AVATAR_DAILY_BUDGET_USD=2.00
AVATAR_MAX_CONTEXT_TOKENS=40000
AVATAR_MAX_INPUT_CHARS=1500
AVATAR_SESSION_RATE_LIMIT=20/hour
AVATAR_IP_RATE_LIMIT=40/day

# Optional — tools degrade to logging if unset
PUSHOVER_USER=
PUSHOVER_TOKEN=

# Snapshot builder in CI only
GITHUB_TOKEN=

# Required by Render (see docs/design.md §9)
GRADIO_SERVER_NAME=0.0.0.0
GRADIO_SERVER_PORT=10000
